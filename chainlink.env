# Chainlink Node Configuration for Ganache
ROOT=/chainlink
LOG_LEVEL=debug
ETH_CHAIN_ID=1337
CHAINLINK_TLS_PORT=0
SECURE_COOKIES=false
ALLOW_ORIGINS=*

# Database
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5432/postgres?sslmode=disable

# Ethereum Connection (connect to Ganache on host machine)
# Use host.docker.internal to access localhost from Docker container
ETH_URL=ws://host.docker.internal:8545
ETH_HTTP_URL=http://host.docker.internal:8545

# Feature Flags
FEATURE_EXTERNAL_INITIATORS=true
FEATURE_OFFCHAIN_REPORTING=true
FEATURE_OFFCHAIN_REPORTING2=true

# Gas Settings (for Ganache - fast and cheap)
ETH_GAS_PRICE_DEFAULT=20000000000
ETH_MAX_GAS_PRICE_WEI=50000000000
ETH_GAS_LIMIT_DEFAULT=500000

# Development mode
CHAINLINK_DEV=true







