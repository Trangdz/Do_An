# Chainlink Node 2 Configuration
ROOT=/chainlink
LOG_LEVEL=debug
CHAINLINK_TLS_PORT=0
SECURE_COOKIES=false

# Database Configuration
DATABASE_URL=postgresql://chainlink:password@postgres2:5432/chainlink_node2?sslmode=disable

# Ethereum Configuration
ETH_URL=http://ganache:7545
ETH_CHAIN_ID=1337

# API Configuration
LINK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAINLINK_DEV=true

# Job Configuration
MINIMUM_CONTRACT_PAYMENT_LINK_JUELS=1000000000000000000
MINIMUM_CONTRACT_PAYMENT_PLINK_JUELS=1000000000000000000

# Web Interface
CHAINLINK_PORT=6688

# Security
PASSWORD=/chainlink/password
API=/chainlink/api

# Logging
LOG_TO_DISK=true
LOG_FILE_PATH=/chainlink/logs/chainlink.log

# Feature Flags
FEATURE_FLUX_MONITOR=true
FEATURE_OFFCHAIN_REPORTING=true
FEATURE_OFFCHAIN_REPORTING2=true
FEATURE_CRON_V2=true
FEATURE_VRF=true
FEATURE_WEBHOOK_V2=true






